---
import Base from '../layouts/Base.astro';
import SubmitForm from './SubmitForm';
import { langOf, lp, t } from '../i18n';

interface Props {
  mode: 'new' | 'fix';
  fid?: string;
  fname?: string;
  back: string;
}
const { mode, fid, fname, back } = Astro.props;
const isFix = mode === 'fix';
const lang = langOf(Astro.url.pathname);
const T = (k: string, v?: Record<string, string | number>) => t(lang, k, v);
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---
<Base title={isFix ? T('form.fixTitle', { name: fname ?? '' }) : T('form.newTitle')} description={T('form.desc')} noindex={isFix}>
  <div class="form-page">
    <a href={lp(lang, back)} class="form-page__back">{T('form.back')}</a>
    <div class="block">
      <span class="kicker">{T(isFix ? 'form.fixKicker' : 'form.newKicker')}</span>
      <h1 class="form-title">{T(isFix ? 'form.fixH1' : 'form.newH1')}</h1>
      <p class="form-intro">
        {T(isFix ? 'form.fixIntro' : 'form.newIntro')}
      </p>
    </div>
    <SubmitForm client:load mode={mode} fid={fid} fname={fname} turnstileKey={turnstileKey} lang={lang} />
  </div>
</Base>
