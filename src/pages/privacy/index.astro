---
import Base from '../../layouts/Base.astro';
import { langOf, lp, t } from '../../i18n';
const lang = langOf(Astro.url.pathname);
const T = (k: string) => t(lang, k);
---
<Base title={T('privacy.title')} description={T('privacy.desc')}>
  <div class="topbar">
    <a class="topbar__back" href={lp(lang, '/')}>{T('fest.back')}</a>
  </div>
  <div class="page-head">
    <span class="kicker">{T('privacy.updated')}</span>
    <h1 class="page-title">{T('privacy.h1')}</h1>
  </div>
  <div class="prose">
    <h2 class="h2">{T('privacy.shortH')}</h2>
    <p>{T('privacy.short')}</p>
    <h2 class="h2">{T('privacy.deviceH')}</h2>
    <p>{T('privacy.device')}</p>
    <h2 class="h2">{T('privacy.partnersH')}</h2>
    <p>{T('privacy.partners')}</p>
    <p>{T('privacy.passes')}</p>
    <p class="small-note"><a href="https://www.travelpayouts.com/" rel="noopener">Travelpayouts</a> · <a href="https://www.kiwi.com/" rel="noopener">Kiwi.com</a> · <a href="https://www.stay22.com/" rel="noopener">Stay22</a></p>
    <h2 class="h2">{T('privacy.otherH')}</h2>
    <ul>
      <li>{T('privacy.hosting')}</li>
      <li>{T('privacy.maps')}</li>
      <li>{T('privacy.forms')}</li>
    </ul>
    <h2 class="h2">{T('privacy.questionsH')}</h2>
    <p><a href="https://www.instagram.com/cubansalsacalendar" rel="noopener">{T('privacy.questions')}</a></p>
  </div>
</Base>
