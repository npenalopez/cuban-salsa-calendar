---
import ListPage from '../components/ListPage.astro';
import { TODAY, stats } from '../lib/data.server';
import { langOf, monthName, t } from '../i18n';

const lang = langOf(Astro.url.pathname);
const s = stats();
---
<ListPage
  route={{ name: 'month', key: null }}
  title={t(lang, 'page.homeTitle')}
  description={t(lang, 'page.homeDesc', { n: s.upcoming, c: s.countries, month: `${monthName(lang, TODAY.getMonth())} ${TODAY.getFullYear()}` })}
/>
