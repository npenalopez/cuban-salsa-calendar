---
// One page per artist: upcoming and past festivals, the acts they belong to, Person / PerformingGroup schema.
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import { MONTHS, dayRange, plural } from '../../../lib/dates';
import { ALL } from '../../../lib/data.server';
import { SITE, festivalPath, place } from '../../../lib/festivals';
import { type ArtistPage, artistPages, artistPath } from '../../../lib/artistPages';

export const getStaticPaths = (() => {
  const pages = artistPages(ALL);
  const slugs = new Set(pages.map((p) => p.slug));
  return pages.map((a) => ({ params: { slug: a.slug }, props: { a, linked: (n: string) => slugs.has(artistPath(n).split('/')[2]) } }));
}) satisfies GetStaticPaths;

const { a, linked } = Astro.props as { a: ArtistPage; linked: (n: string) => boolean };
const KIND = { person: 'Dancer and teacher', couple: 'Dance couple', group: 'Group', dj: 'DJ' } as const;
const n = a.upcoming.length;
const years = [...new Set(a.upcoming.map((h) => h.f.s.getFullYear()))].sort();
const yearsLabel = years.length > 1 ? `${years[0]}–${years[years.length - 1]}` : String(years[0] ?? '');
const title = n ? `${a.name}: Upcoming Cuban Salsa Festivals ${yearsLabel}` : `${a.name}: Cuban Salsa Festivals`;
const next = a.upcoming.slice(0, 3).map((h) => `${h.f.name} (${h.f.city || place(h.f)}, ${MONTHS[h.f.s.getMonth()].slice(0, 3)} ${h.f.s.getFullYear()})`);
const description = n
  ? `${a.name} at ${plural(n, 'upcoming festival')}: ${next.join(', ')}${n > 3 ? ' and more' : ''}. Dates, places and line-ups.`
  : `Festivals where ${a.name} taught or performed, with dates and places.`;
const intro = n
  ? `${a.name} is on the line-up of ${plural(n, 'upcoming Cuban salsa festival')}${a.countries.length ? ` in ${a.countries.length === 1 ? a.countries[0] : `${a.countries.length} countries`}` : ''}.${a.past.length ? ` ${plural(a.past.length, 'past festival')} listed below.` : ''}`
  : `No upcoming festival lists ${a.name} yet. Past festivals are below.`;

const ld: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': a.kind === 'group' || a.kind === 'couple' ? 'PerformingGroup' : 'Person',
  name: a.name,
  url: SITE + `/artists/${a.slug}/`,
  performerIn: a.upcoming.map(({ f }) => ({
    '@type': 'DanceEvent', name: f.name, url: SITE + festivalPath(f.id), startDate: f.startDate, endDate: f.endDate,
    location: { '@type': 'Place', name: f.venue || f.city || place(f), address: { '@type': 'PostalAddress', addressLocality: f.city ?? undefined, addressCountry: f.countryCode ?? undefined } },
  })),
};
if (a.members.length) ld.member = a.members.map((m) => ({ '@type': 'Person', name: m }));
if (a.memberOf.length) ld.memberOf = a.memberOf.map((m) => ({ '@type': 'PerformingGroup', name: m }));
---
<Base title={title} description={description} noindex={n === 0}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(ld).replace(/</g, '\\u003c')} />
  <div class="topbar">
    <a class="topbar__back" href="/artists/">← All artists</a>
  </div>
  <div class="page-head">
    <span class="kicker">{KIND[a.kind]}</span>
    <h1 class="page-title page-title--name">{a.name}</h1>
    <p class="page-note">{intro}</p>
  </div>

  {(a.members.length > 0 || a.memberOf.length > 0) && (
    <p class="artist-rel">
      {a.members.length > 0 && <>Members: {a.members.map((m, i) => <>{i > 0 && ', '}{linked(m) ? <a href={artistPath(m)}>{m}</a> : m}</>)}</>}
      {a.memberOf.length > 0 && <>Also dances as {a.memberOf.map((m, i) => <>{i > 0 && ', '}{linked(m) ? <a href={artistPath(m)}>{m}</a> : m}</>)}</>}
    </p>
  )}

  {n > 0 && (
    <section class="land-group" aria-labelledby="up-h">
      <h2 class="h2 land-group__head" id="up-h">Upcoming festivals<span class="h2__count">{n}</span></h2>
      {a.upcoming.map(({ f, via }) => (
        <a class="more-row land-row" href={festivalPath(f.id)}>
          <span class="more-row__when">{dayRange(f)}</span>
          <span class="more-row__text">
            <strong>{f.name}</strong>
            <span>{MONTHS[f.s.getMonth()]} {f.s.getFullYear()} · {place(f)}{f.status === 'postponed' ? ' · Postponed' : f.status === 'cancelled' ? ' · Cancelled' : ''}</span>
            {via && <span class="land-row__lineup">with {via}</span>}
          </span>
        </a>
      ))}
    </section>
  )}

  {a.past.length > 0 && (
    <details class="land-past" open={n === 0}>
      <summary class="h2">Past festivals<span class="h2__count">{a.past.length}</span></summary>
      {a.past.map(({ f, via }) => (
        <a class="more-row land-row" href={festivalPath(f.id)}>
          <span class="more-row__when">{dayRange(f)}</span>
          <span class="more-row__text"><strong>{f.name}</strong><span>{MONTHS[f.s.getMonth()]} {f.s.getFullYear()} · {place(f)}{via ? ` · with ${via}` : ''}</span></span>
        </a>
      ))}
    </details>
  )}

  <p class="small-note artist-note">Line-ups come from the organizers' own pages and change often. Check the festival page before you book.</p>
</Base>
