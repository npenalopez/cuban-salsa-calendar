---
// One page per artist: upcoming and past festivals, the acts they belong to, Person / PerformingGroup schema.
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import { dayRange } from '../../../lib/dates';
import { langOf, lp, monthName, monthShort, t } from '../../../i18n';
import { inCountry } from '../../../i18n/places';
import { ALL } from '../../../lib/data.server';
import { SITE, festivalPath, place } from '../../../lib/festivals';
import { type ArtistPage, artistPages, artistPath } from '../../../lib/artistPages';

export const getStaticPaths = (() => {
  const pages = artistPages(ALL);
  const slugs = new Set(pages.map((p) => p.slug));
  return pages.map((a) => ({ params: { slug: a.slug }, props: { a, linked: (n: string) => slugs.has(artistPath(n).split('/')[2]) } }));
}) satisfies GetStaticPaths;

const { a, linked } = Astro.props as { a: ArtistPage; linked: (n: string) => boolean };
const lang = langOf(Astro.url.pathname);
const T = (k: string, v?: Record<string, string | number>) => t(lang, k, v);
const L = (path: string) => lp(lang, path);
const n = a.upcoming.length;
const years = [...new Set(a.upcoming.map((h) => h.f.s.getFullYear()))].sort();
const yearsLabel = years.length > 1 ? `${years[0]}–${years[years.length - 1]}` : String(years[0] ?? '');
const title = n ? T('artist.title', { name: a.name, years: yearsLabel }) : T('artist.titlePast', { name: a.name });
const next = a.upcoming.slice(0, 3).map((h) => `${h.f.name} (${h.f.city || place(h.f, lang)}, ${monthShort(lang, h.f.s.getMonth())} ${h.f.s.getFullYear()})`);
const description = n ? T('artist.desc', { name: a.name, n, list: next.join(', '), more: n > 3 ? T('fest.descMore') : '' }) : T('artist.descPast', { name: a.name });
const countriesWhere = a.countries.length === 0 ? '' : a.countries.length === 1 ? t(lang, 'land.where', { place: inCountry(lang, a.upcoming.find((h) => h.f.country === a.countries[0])?.f.countryCode, a.countries[0]) }) : T('artist.inCountries', { n: a.countries.length });
const intro = n ? T('artist.intro', { name: a.name, n, where: countriesWhere }) + (a.past.length ? T('artist.pastBelow', { n: a.past.length }) : '') : T('artist.none', { name: a.name });

const ld: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': a.kind === 'group' || a.kind === 'couple' ? 'PerformingGroup' : 'Person',
  name: a.name,
  url: SITE + L(`/artists/${a.slug}/`),
  performerIn: a.upcoming.map(({ f }) => ({
    '@type': 'DanceEvent', name: f.name, url: SITE + L(festivalPath(f.id)), startDate: f.startDate, endDate: f.endDate,
    location: { '@type': 'Place', name: f.venue || f.city || place(f), address: { '@type': 'PostalAddress', addressLocality: f.city ?? undefined, addressCountry: f.countryCode ?? undefined } },
  })),
};
if (a.members.length) ld.member = a.members.map((m) => ({ '@type': 'Person', name: m }));
if (a.memberOf.length) ld.memberOf = a.memberOf.map((m) => ({ '@type': 'PerformingGroup', name: m }));
---
<Base title={title} description={description} noindex={n === 0}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(ld).replace(/</g, '\\u003c')} />
  <div class="topbar">
    <a class="topbar__back" href={L('/artists/')}>{T('artist.back')}</a>
  </div>
  <div class="page-head">
    <span class="kicker">{T(`artist.${a.kind}`)}</span>
    <h1 class="page-title page-title--name">{a.name}</h1>
    <p class="page-note">{intro}</p>
  </div>

  {(a.members.length > 0 || a.memberOf.length > 0) && (
    <p class="artist-rel">
      {a.members.length > 0 && <>{T('artist.members')} {a.members.map((m, i) => <>{i > 0 && ', '}{linked(m) ? <a href={L(artistPath(m))}>{m}</a> : m}</>)}</>}
      {a.memberOf.length > 0 && <>{T('artist.alsoAs')} {a.memberOf.map((m, i) => <>{i > 0 && ', '}{linked(m) ? <a href={L(artistPath(m))}>{m}</a> : m}</>)}</>}
    </p>
  )}

  {n > 0 && (
    <section class="land-group" aria-labelledby="up-h">
      <h2 class="h2 land-group__head" id="up-h">{T('artist.upcoming')}<span class="h2__count">{n}</span></h2>
      {a.upcoming.map(({ f, via }) => (
        <a class="more-row land-row" href={L(festivalPath(f.id))}>
          <span class="more-row__when">{dayRange(f, lang)}</span>
          <span class="more-row__text">
            <strong>{f.name}</strong>
            <span>{monthName(lang, f.s.getMonth())} {f.s.getFullYear()} · {place(f, lang)}{f.status === 'postponed' || f.status === 'cancelled' ? ` · ${T(`badge.${f.status}`)}` : ''}</span>
            {via && <span class="land-row__lineup">{T('artist.with', { act: via })}</span>}
          </span>
        </a>
      ))}
    </section>
  )}

  {a.past.length > 0 && (
    <details class="land-past" open={n === 0}>
      <summary class="h2">{T('land.past')}<span class="h2__count">{a.past.length}</span></summary>
      {a.past.map(({ f, via }) => (
        <a class="more-row land-row" href={L(festivalPath(f.id))}>
          <span class="more-row__when">{dayRange(f, lang)}</span>
          <span class="more-row__text"><strong>{f.name}</strong><span>{monthName(lang, f.s.getMonth())} {f.s.getFullYear()} · {place(f, lang)}{via ? ` · ${T('artist.with', { act: via })}` : ''}</span></span>
        </a>
      ))}
    </details>
  )}

  <p class="small-note artist-note">{T('artist.note')}</p>
</Base>
