---
// All artists A–Z, busiest first at the top. Plain links, no islands.
import Base from '../../layouts/Base.astro';
import { langOf, lp, t } from '../../i18n';
import { ALL } from '../../lib/data.server';
import { artistPages } from '../../lib/artistPages';

const lang = langOf(Astro.url.pathname);
const T = (k: string, v?: Record<string, string | number>) => t(lang, k, v);
const L = (path: string) => lp(lang, path);
const pages = artistPages(ALL).filter((a) => a.upcoming.length > 0);
const yrs = [...new Set(pages.flatMap((a) => a.upcoming.map((h) => h.f.s.getFullYear())))].sort();
const years = yrs.length > 1 ? `${yrs[0]}–${yrs[yrs.length - 1]}` : String(yrs[0] ?? '');
const top = [...pages].sort((a, b) => b.upcoming.length - a.upcoming.length || a.name.localeCompare(b.name)).slice(0, 20);
const groups = new Map<string, typeof pages>();
for (const a of pages) {
  const l = a.name.normalize('NFKD').replace(/[̀-ͯ]/g, '').replace(/^dj\s+/i, '')[0]?.toUpperCase() ?? '#';
  const k = /[A-Z]/.test(l) ? l : '#';
  groups.set(k, [...(groups.get(k) ?? []), a]);
}
const letters = [...groups.keys()].sort();
---
<Base title={T('artists.title', { years })} description={T('artists.desc', { n: pages.length })}>
  <div class="topbar">
    <a class="topbar__back" href={L('/')}>{T('fest.back')}</a>
  </div>
  <div class="page-head">
    <span class="kicker">{T('artists.kicker')}</span>
    <h1 class="page-title">{T('artists.h1')}</h1>
    <p class="page-note">{T('artists.intro', { n: pages.length })}</p>
  </div>

  <section class="land-related" aria-labelledby="top-h">
    <h2 class="h2" id="top-h">{T('artists.top')}</h2>
    <ul>{top.map((a) => <li><a href={L(`/artists/${a.slug}/`)}>{a.name}</a><span class="meta">{a.upcoming.length}</span></li>)}</ul>
  </section>

  <nav class="az" aria-label={T('artists.jump')}>{letters.map((l) => <a href={`#l-${l}`}>{l}</a>)}</nav>
  {letters.map((l) => (
    <section class="land-related" aria-labelledby={`l-${l}`}>
      <h2 class="h2" id={`l-${l}`}>{l}</h2>
      <ul>{groups.get(l)!.map((a) => <li><a href={L(`/artists/${a.slug}/`)}>{a.name}</a><span class="meta">{a.upcoming.length}</span></li>)}</ul>
    </section>
  ))}
</Base>
