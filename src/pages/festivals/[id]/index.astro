---
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import { AddToCalendar, FestivalMap, Lineup, TopActions, TravelLine } from '../../../components/FestivalIslands';
import { MONTHS, countdownLong, dateLong, dayRange, daysBetween, monthLabel, monthPath, plural } from '../../../lib/dates';
import { ALL, TODAY, UPCOMING } from '../../../lib/data.server';
import { SITE, byDate, canAddToCalendar, festivalPath, fixPath, fmtPrice, nextEdition, place, priceLabel, ticketOf } from '../../../lib/festivals';
import type { Enriched } from '../../../lib/types';
import { countryPath, eventLd, festivalTitle, inName, regionPath } from '../../../lib/seo';
import { STYLES, stylePath } from '../../../lib/styles';

export const getStaticPaths = (() => ALL.map((f) => ({ params: { id: f.id }, props: { f } }))) satisfies GetStaticPaths;

const { f } = Astro.props as { f: Enriched };
const url = SITE + festivalPath(f.id);
const a = f.artists;
const ticket = ticketOf(f);
const price = fmtPrice(f);
const where = [f.venue, place(f)].filter(Boolean).join(', ');

// Status banner
let status: { kind: string; title: string; text: string } | null = null;
if (f.status === 'postponed') status = { kind: 'postponed', title: 'Postponed.', text: "New dates haven't been announced yet." };
else if (f.status === 'cancelled') status = { kind: 'cancelled', title: 'Cancelled.', text: "This edition won't take place." };
else if (f.past)
  status = { kind: 'past', title: 'This festival already took place.', text: nextEdition(f, ALL) ? 'The next edition is listed below.' : "The next edition hasn't been announced." };
else if (f.status === 'sold-out') status = { kind: 'sold-out', title: 'Sold out.', text: 'Check the organizer for a waiting list.' };

// "2 days · starts in 58 days" (the countdown is refreshed in the browser, below)
const length = plural(daysBetween(f.s, f.e) + 1, 'day');

const ig = f.instagram || null;
const others = f.series
  ? ALL.filter((x) => x.series === f.series && x.id !== f.id).sort(byDate).map((x) => ({
      href: festivalPath(x.id),
      label: x.name,
      when: x.datePrecision === 'year' ? String(x.s.getFullYear()) : `${MONTHS[x.s.getMonth()]} ${x.s.getFullYear()}`,
    }))
  : [];
const more = f.mk && !f.arch ? UPCOMING.filter((x) => x.mk === f.mk && x.id !== f.id).sort(byDate).slice(0, 4) : [];

const ld = eventLd(f);
const country = f.country ? UPCOMING.filter((x) => x.country === f.country && x.id !== f.id).sort(byDate).slice(0, 4) : [];

const title = festivalTitle(f);
const description = [
  `${f.name}, ${dateLong(f)}, ${place(f)}.`,
  a.length ? `Line-up: ${a.slice(0, 6).join(', ')}${a.length > 6 ? ' and more' : ''}.` : '',
  price ? `Passes ${price}.` : '',
].filter(Boolean).join(' ');
---
<Base title={title} description={description} ogImage={`/og/${f.id}.png`} ogType="article">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(ld).replace(/</g, '\\u003c')} />

  <div class="topbar">
    <a class="topbar__back" href="/" id="back-link">← All festivals</a>
    <TopActions client:afterload id={f.id} name={f.name} url={url} canSave={!f.arch} />
  </div>

  <div class="fest">
    <div class="fest__col">
      {status && <div role="status" class={`status status--${status.kind}`}><strong>{status.title}</strong> {status.text}</div>}
      <div class="fest__head">
        <span class="fest__place">
          {f.countryCode && <img class="flag" src={`/flags/${f.countryCode.toLowerCase()}.svg`} alt="" width="20" height="14" />}
          {place(f)}
        </span>
        <h1 class="fest__name">{f.name}</h1>
        <span class="fest__date">{dateLong(f)}</span>
        <span class="meta">{length} · <span data-countdown data-start={f.startDate} data-end={f.endDate}>{countdownLong(f.s, f.e, TODAY)}</span></span>
        {f.coordinates && !f.arch && <TravelLine client:afterload coords={f.coordinates} />}
      </div>

      {ticket && (
        <div class="passes">
          <a class="passes__btn" href={ticket} target="_blank" rel="sponsored noopener">Get passes{f.priceFrom != null ? ` · ${price}` : ''} ↗</a>
          <span class="passes__note">Passes are sold by the organizer.</span>
        </div>
      )}

      <div class="actions-grid">
        {canAddToCalendar(f) && <AddToCalendar client:afterload id={f.id} />}
        {ig && <a class="btn" href={ig} target="_blank" rel="noopener">{/\/p\//.test(ig) ? 'Instagram post' : 'Instagram'} ↗</a>}
        {f.website && <a class="btn btn--ghost" href={f.website} target="_blank" rel="noopener">Festival website ↗</a>}
      </div>
      {!ig && !f.website && (
        <p class="no-links">We don't have a website or Instagram for this festival yet. <a href={fixPath(f.id)}>Know it? Tell us.</a></p>
      )}

      <dl class="facts">
        <dt>Where</dt><dd>{where}</dd>
        <dt>Price</dt><dd>{priceLabel(f) || 'Not announced yet'}</dd>
        <dt>Region</dt><dd><a href={regionPath(f.region)}>{f.region}</a></dd>
        {f.styles?.length ? <><dt>Styles</dt><dd>{STYLES.filter((x) => f.styles!.includes(x.key)).map((x, i) => <>{i > 0 && ', '}<a href={stylePath(x.key)}>{x.label}</a></>)}</dd></> : null}
      </dl>

      {others.length > 0 && (
        <div class="block">
          <h2 class="h2">Other editions</h2>
          {others.map((o) => <a class="row-between" href={o.href}><span>{o.label}</span><span class="meta">{o.when} ›</span></a>)}
        </div>
      )}
    </div>

    <div class="fest__col fest__col--right">
      <div class="block block--10">
        <h2 class="h2">Line-up{a.length > 0 && <span class="h2__count">{a.length}</span>}</h2>
        {a.length ? <Lineup client:afterload artists={a} /> : <p class="meta" style="margin:0;font-size:15px">Not announced yet.</p>}
      </div>
      <div class="block">
        <h2 class="h2">About</h2>
        <p class="about">{f.description || 'No description yet.'}</p>
      </div>
      {f.coordinates && (
        <div class="block" style="gap:4px">
          <FestivalMap client:afterload id={f.id} name={f.name} lat={f.coordinates[0]} lng={f.coordinates[1]} label={`Map of ${place(f)}`} place={place(f)} />
          <a class="inline-link" href={`https://www.google.com/maps/search/?api=1&query=${f.coordinates[0]},${f.coordinates[1]}`} target="_blank" rel="noopener">Directions in Maps ↗</a>
        </div>
      )}
      <div class="verified">
        <span>{f.lastVerified ? `Info last checked ${f.lastVerified}` : "Info from the organizer's public channels."}</span>
        <a class="inline-link" href={fixPath(f.id)}>Something wrong? Suggest a correction</a>
      </div>
      {f.country && (
        <div class="more">
          <h2 class="h2">More festivals in {inName(f.country)}</h2>
          {country.map((x) => (
            <a class="more-row" href={festivalPath(x.id)}>
              <span class="more-row__when">{dayRange(x)}</span>
              <span class="more-row__text"><strong>{x.name}</strong><span>{MONTHS[x.s.getMonth()]} {x.s.getFullYear()} · {x.city || place(x)}</span></span>
            </a>
          ))}
          {country.length === 0 && <p class="meta">No other upcoming festival in {inName(f.country)} yet.</p>}
          <a class="inline-link" href={countryPath(f.country)}>All Cuban salsa festivals in {inName(f.country)} ›</a>
        </div>
      )}
      {more.length > 0 && f.mk && (
        <div class="more">
          <h2 class="h2">More in {monthLabel(f.mk)}</h2>
          {more.map((x) => (
            <a class="more-row" href={festivalPath(x.id)}>
              <span class="more-row__when">{dayRange(x)}</span>
              <span class="more-row__text"><strong>{x.name}</strong><span>{place(x)}</span></span>
            </a>
          ))}
          <a class="inline-link" href={monthPath(f.mk)}>See all of {MONTHS[f.s.getMonth()]} ›</a>
        </div>
      )}
    </div>
  </div>

  <script>
    import { countdownLong, pISO, startOfToday } from '../../../lib/dates';
    // The page is built once a day; count the days from the visitor's today.
    for (const el of document.querySelectorAll<HTMLElement>('[data-countdown]'))
      el.textContent = countdownLong(pISO(el.dataset.start!), pISO(el.dataset.end!), startOfToday());
    // "← All festivals" returns to the last list page the visitor came from.
    try {
      const last = sessionStorage.getItem('csc-last-list');
      const a = document.getElementById('back-link') as HTMLAnchorElement | null;
      if (last && a) a.href = last;
    } catch {}
  </script>
</Base>
