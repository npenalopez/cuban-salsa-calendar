---
// Spanish and French copy of the English page (the page reads its language from the URL).
import type { GetStaticPaths } from 'astro';
import Page from '../../../artists/[slug]/index.astro';
import { LANGS } from '../../../../i18n';
import { ALL } from '../../../../lib/data.server';
import { type ArtistPage, artistPages, artistPath } from '../../../../lib/artistPages';
export const getStaticPaths = (() => {
  const langs = LANGS.filter((l) => l !== 'en');
  const pages = artistPages(ALL);
  const slugs = new Set(pages.map((p) => p.slug));
  const linked = (n: string) => slugs.has(artistPath(n).split('/')[2]);
  return langs.flatMap((lang) => pages.map((a) => ({ params: { lang, slug: a.slug }, props: { a, linked } })));
}) satisfies GetStaticPaths;

const props = Astro.props as { a: ArtistPage; linked: (n: string) => boolean };
---
<Page a={props.a} linked={props.linked} />
