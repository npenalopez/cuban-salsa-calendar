---
// Spanish and French copy of the English page (the page reads its language from the URL).
import type { GetStaticPaths } from 'astro';
import Page from '../../archive/index.astro';
import { LANGS } from '../../../i18n';

export const getStaticPaths = (() => LANGS.filter((l) => l !== 'en').map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;
---
<Page />
