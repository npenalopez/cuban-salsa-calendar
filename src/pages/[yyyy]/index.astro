---
import type { GetStaticPaths } from 'astro';
import LandingPage from '../../components/LandingPage.astro';
import { ALL } from '../../lib/data.server';
import { type Landing, landings } from '../../lib/seo';

export const getStaticPaths = (() => {
  const all = landings(ALL);
  return all.filter((l) => l.kind === 'year').map((l) => ({ params: { yyyy: l.label }, props: { l, all } }));
}) satisfies GetStaticPaths;

const { l, all } = Astro.props as { l: Landing; all: Landing[] };
---
<LandingPage l={l} all={all} />
