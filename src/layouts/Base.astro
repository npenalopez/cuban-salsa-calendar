---
import '../styles/fonts.css';
import '../styles/global.css';
import HeaderActions from '../components/HeaderActions';
import GlobalSheets from '../components/GlobalSheets';
import { INSTAGRAM, SITE } from '../lib/festivals';
import { TODAY, stats } from '../lib/data.server';

interface Props {
  title: string;
  description?: string;
  /** Path for the canonical URL; defaults to the current path. */
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  /** Extra bottom padding so the dock never covers the last card. */
  dock?: boolean;
  mainClass?: string;
}
const {
  title,
  description = 'Dates, cities and line-ups for Cuban salsa, timba and Afro-Cuban festivals around the world.',
  canonical = Astro.url.pathname,
  ogImage = '/og/default.png',
  ogType = 'website',
  noindex = false,
  dock = false,
  mainClass = '',
} = Astro.props;
const canonicalUrl = new URL(canonical, SITE).href;
const ogUrl = new URL(ogImage, SITE).href;
const s = stats();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content="Cuban Salsa Calendar" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#F6EDE3" />
    <link rel="preload" href="/fonts/archivo-core.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="text/calendar" title="All festivals" href="/feeds/all.ics" />
    <script is:inline>
      try {
        var t = JSON.parse(localStorage.getItem('csc-theme') || 'null');
        // Light unless the visitor chose Dark or Auto (follow the device).
        if (t === 'dark' || t === 'system') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip">Skip to festivals</a>
    <header class="header">
      <div class="header__inner">
        <a href="/" class="logo"><span aria-hidden="true" class="logo__flag"></span>Cuban Salsa Calendar</a>
        <HeaderActions client:afterload />
      </div>
    </header>
    <main id="main" tabindex="-1" class:list={['main', dock && 'main--dock', mainClass]}>
      <slot />
      <footer class="footer">
        <div class="footer__about">
          <strong class="footer__name">Cuban Salsa Calendar</strong>
          <span>A community-kept list of Cuban salsa, timba and Afro-Cuban festivals around the world. Free to use.</span>
        </div>
        <div class="footer__links">
          <a href={INSTAGRAM} target="_blank" rel="noopener">@cubansalsacalendar ↗</a>
          <a href="/submit/">Submit a festival</a>
        </div>
        <span class="footer__copy">© {TODAY.getFullYear()} Cuban Salsa Calendar · {s.upcoming} upcoming festivals in {s.countries} countries</span>
      </footer>
    </main>
    <GlobalSheets client:afterload />
  </body>
</html>
