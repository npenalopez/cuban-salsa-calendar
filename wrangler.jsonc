{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static site + a small Worker: `npm run build`, then `npx wrangler deploy`.
  "name": "cuban-salsa-calendar",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only these paths run code; every page is served straight from dist/.
    "run_worker_first": ["/api/*", "/admin", "/admin/*"],
    "not_found_handling": "404-page",
    // /archive → /archive/ (matches the canonical URLs).
    "html_handling": "auto-trailing-slash"
  },
  // Per-IP limit for the submit and correction forms.
  "ratelimits": [{ "name": "SUBMIT_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "observability": { "enabled": true },
  // Keep variables set in the dashboard when GitHub deploys.
  "keep_vars": true,
  "vars": {
    "GITHUB_REPO": "npenalopez/cuban-salsa-calendar"
  }
  // Runtime secrets (dashboard → Worker → Settings → Variables and Secrets, type Secret; or `npx wrangler secret put`):
  //   GITHUB_TOKEN        fine-grained token, "Issues: read and write" on the repo
  //   TURNSTILE_SECRET    Turnstile secret key
  //   ACCESS_TEAM_DOMAIN  e.g. "nestor" for nestor.cloudflareaccess.com
  //   ACCESS_AUD          the Access application's Audience (AUD) tag for /admin
  // Local development reads them from `.dev.vars` (see .dev.vars.example).
}
