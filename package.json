{
  "name": "cuban-salsa-calendar",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "validate": "node scripts/validate-data.mjs",
    "build": "npm run validate && astro build",
    "preview": "astro preview",
    "check": "astro check && tsc -p worker",
    "test": "vitest run",
    "serve:cf": "wrangler dev --port 8789",
    "check:a11y": "node scripts/a11y.mjs",
    "check:lighthouse": "node scripts/lighthouse.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/preact": "^6.0.5",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "astro": "^7.3.5",
    "flag-icons": "^7.5.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^5.20261001.1",
    "@fontsource-variable/archivo": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^26.6.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "lighthouse": "^13.5.0",
    "playwright": "^1.63.0",
    "satori": "^0.33.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.145.0"
